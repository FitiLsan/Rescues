  Name: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u0434\u043B\u044F \u0425\u0430\u0433\u0435\u043D\u0430"
  Description: "\u0425\u0430\u0433\u0435\u043D, \u0441\u043D\u043E\u0432\u0430 \u0432\u044B\u0440\u0443\u0431\u0438\u043B\u043E
    \u0441\u0432\u0435\u0442! \r\n\u042F \u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E
    \u043F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u044F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u0449\u0438\u0442\u043E\u043A \u0432 \u043F\u043E\u0434\u0432\u0430\u043B\u0435.
    \r\n\u041A\u043B\u044E\u0447 \u043E\u0442 \u043F\u043E\u0434\u0432\u0430\u043B\u0430
    \u043D\u0430 \u0441\u0442\u043E\u0439\u043A\u0435, \u043D\u043E \u0434\u0432\u0435\u0440\u044C
    \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438 \u043A\u043B\u0438\u043D\u0438\u0442,
    \u0442\u0430\u043A \u0447\u0442\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
    \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u0442\u044C
    \u0441\u0438\u043B\u0443, \u0447\u0442\u043E\u0431\u044B \u0435\u0451 \u043E\u0442\u043A\u0440\u044B\u0442\u044C.
    \u041D\u043E \u0442\u044B \u043F\u0430\u0440\u0435\u043D\u044C \u043A\u0440\u0435\u043F\u043A\u0438\u0439,
    \u0441\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F. \r\n\u041A\u0430\u043A
    \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0448\u044C, \u0432\u0441\u0451 \u0437\u0430\u043A\u0440\u043E\u0439,
    \u0438 \u0432\u0435\u0440\u043D\u0438 \u043A\u043B\u044E\u0447 \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
  Icon: {fileID: 21300000, guid: 5c83ea5f3cbffad4ab50b0a02dadb878, type: 3}
